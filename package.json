{
  "name": "@deepseek-ai/dsh-dot-background",
  "description": "DeepSeek Harness Web plugin: a breathing, color-shifting DeepSeek dot-matrix whale backdrop rendered on canvas",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "install.sh",
    "uninstall.sh"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zh-U-hB/dsh-dot-background.git"
  },
  "bugs": {
    "url": "https://github.com/Zh-U-hB/dsh-dot-background/issues"
  },
  "homepage": "https://github.com/Zh-U-hB/dsh-dot-background#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "dot-matrix",
    "background",
    "canvas",
    "animation"
  ]
}
